# Copy to .env and replace the placeholder locally. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional read-only office client directory integration (local client-files app).
CLIENT_FILES_URL=http://127.0.0.1:3021

# Local PDF.js/canvas installation for COR page rendering. Credentials go in
# ignored secrets/gds-gateway.env: GDS_BASE_URL, GDS_API_KEY and GDS_MODEL.
COR_NODE_MODULES=
