SERVER_BIND_IP=192.168.8.200
EBIR_SITE=https://192.168.8.200:8443
SERVER_ALLOWED_HOSTS=192.168.8.200,localhost,127.0.0.1
SERVER_CSRF_ORIGINS=https://192.168.8.200:8443
# Must be an existing SMB-mounted CLIENT directory, writable by uid/gid 1000.
CLIENT_SHARE_PATH=/mnt/starlight/CLIENT
# For migration retain the existing app's key: Gmail encryption depends on it.
# For a fresh deployment generate a new random key of at least 50 characters.
DJANGO_SECRET_KEY=
GDS_BASE_URL=
GDS_API_KEY=
GDS_MODEL=
GMAIL_RECEIPT_SENDER=ebirforms-noreply@bir.gov.ph
